# ═══════════════════════════════════════════════════════════════
#  微信 AI 助手 · Git 忽略规则
# ═══════════════════════════════════════════════════════════════

# ── 敏感数据（务必不要提交）──────────────────────────────────
# 这里存着大模型 API Key、网关 Token 与聊天记录
data/*
!data/.gitkeep
*.jsonl
# Public, frozen synthetic decision-model regression fixture (never private chat).
!tools/decision_model/stress-v1.jsonl
# Reproducible synthetic exports; source lives in src/personas/phrolova.py.
personas/phrolova/generated/
config.json

# ── 运行环境 ─────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
*.egg-info/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 编辑器 / 系统 ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── 日志与临时文件 ───────────────────────────────────────────
*.log
logs/
tmp/
.cache/

# ── 桌面版（Electron）────────────────────────────────────────
desktop/node_modules/
desktop/dist/
desktop/build/
desktop/.pyinstaller-cache/
# PyInstaller 产出的后端二进制体积大，由 npm run build:backend 现场生成
desktop/resources/backend/
# 图标由 scripts/make-icons.py 生成，但保留它们方便直接打包
!desktop/assets/

# ── 环境变量 ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── AI 助手工作目录（工具元数据，非项目源码）──────────────────
.workbuddy-ai/
.claude/
.cursor/

# Validated offline model artifacts are built separately, never committed.
desktop/resources/decision-model/
resources/decision-model/

# Native-build license inventory is generated from the packaged runtime.
desktop/resources/third-party/

# Pinned native QQ archive is downloaded/verified at Windows package time.
desktop/resources/napcat/*.zip
