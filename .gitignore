# ═══════════════════════════════════════════════════════════════
#  微信 AI 助手 · Git 忽略规则
# ═══════════════════════════════════════════════════════════════

# ── 敏感数据（务必不要提交）──────────────────────────────────
# 这里存着大模型 API Key、网关 Token 与聊天记录
data/*
!data/.gitkeep
*.jsonl
config.json

# ── 运行环境 ─────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
*.egg-info/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 编辑器 / 系统 ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── 日志与临时文件 ───────────────────────────────────────────
*.log
logs/
tmp/
.cache/

# ── 环境变量 ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── AI 助手工作目录（工具元数据，非项目源码）──────────────────
.workbuddy-ai/
.claude/
.cursor/
