# ── 复制为 .env 并填入真实值 ──────────────────────────────
# 严禁把此文件提交到代码仓库

# ── 协议网关（Gewechat / WeChatPadPro）────────────────────
GEWE_BASE_URL=http://gateway:2531
GEWE_TOKEN=your_gewe_token_here
GEWE_APP_ID=your_app_id_here
BOT_WXID=wxid_your_bot_account

# ── LLM：主对话模型（推荐 DeepSeek-V4-Flash）──────────────
LLM_PRIMARY_BASE=https://api.deepseek.com
LLM_PRIMARY_KEY=sk-your-deepseek-key
LLM_PRIMARY_MODEL=deepseek-chat

# ── LLM：降级兜底（推荐 qwen-plus）───────────────────────
LLM_FALLBACK_KEY=sk-your-dashscope-key

# ── LLM：群聊触发判定（推荐 GLM-4.7-Flash，免费）──────────
LLM_JUDGE_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_JUDGE_KEY=your-zhipu-key
LLM_JUDGE_MODEL=glm-4.7-flash

# ── 机器人人设 ───────────────────────────────────────────
BOT_PERSONA=友好、简洁、懂技术的群聊助手

# ── 存储 ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://bot:bot@postgres:5432/wxbot
PG_USER=bot
PG_PASSWORD=bot
PG_DB=wxbot

# ── 可观测性 ─────────────────────────────────────────────
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin
