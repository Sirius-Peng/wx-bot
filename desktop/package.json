{
  "name": "wxbot-desktop",
  "version": "3.0.2",
  "description": "微信 AI 助手 · 桌面版（Electron 外壳 + Python 引擎 sidecar）",
  "main": "src/main/index.js",
  "author": {
    "name": "Sirius-Peng",
    "email": "54427718+Sirius-Peng@users.noreply.github.com",
    "url": "https://github.com/Sirius-Peng"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.cjs",
    "build:backend": "bash scripts/build-backend.sh",
    "build:backend:win": "scripts\\build-backend.bat",
    "icons": "python3 scripts/make-icons.py",
    "verify:arch": "bash scripts/verify-arch.sh",
    "pack:mac": "npm run verify:resources && npm run build:backend && electron-builder --mac --arm64 && npm run verify:arch arm64",
    "pack:mac:x64": "npm run verify:resources && npm run build:backend && electron-builder --mac --x64 && npm run verify:arch x64",
    "pack:win": "npm run verify:resources && npm run build:backend:win && electron-builder --win --x64 && npm run verify:win",
    "pack:all": "npm run verify:resources && node scripts/pack-native.cjs",
    "verify:win": "node scripts/verify-windows.cjs",
    "test:windows": "node ../tests/test_windows_desktop.cjs && node ../tests/test_windows_lifecycle.cjs && node ../tests/test_storage_paths.cjs && node ../tests/test_input_focus.cjs",
    "verify:model": "node scripts/verify-decision-model.cjs",
    "prepack": "npm run verify:resources",
    "test:pack-gate": "node ../tests/test_model_pack_gate.cjs && node ../tests/test_cloud_package.cjs",
    "verify:resources": "node scripts/verify-runtime-resources.cjs --source-only"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "esbuild": "0.25.12"
  },
  "contributors": [
    {
      "name": "Sirius-Peng",
      "url": "https://github.com/Sirius-Peng"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sirius-Peng/wx-bot.git"
  },
  "homepage": "https://github.com/Sirius-Peng/wx-bot#readme",
  "bugs": {
    "url": "https://github.com/Sirius-Peng/wx-bot/issues"
  }
}
